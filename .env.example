# Copy to .env and fill in. NEVER commit the real .env.

# --- required in production ---
SESSION_SECRET=            # long random string; signs sessions & signed file URLs

# --- app ---
PORT=3000
NODE_ENV=production
PUBLIC_URL=                # e.g. https://autolist.ai (used for canonical/OG + signed links)
CORS_ORIGINS=             # comma-separated origins allowed to call /api (leave blank for same-origin)

# --- storage / security ---
DATA_KEY=                 # optional dedicated key for encrypting connection tokens (falls back to SESSION_SECRET)
FILE_STORE_DIR=           # optional; defaults to ./data/files
MALWARE_SCAN_URL=         # optional external malware scanner endpoint

# --- AI providers (optional; deterministic fallbacks run without keys) ---
ANTHROPIC_API_KEY=        # enables live Claude text generation
AI_PROVIDER=              # set to "template" to force the deterministic generator
IMAGE_API_KEY=            # enables text-to-image generation
IMAGE_MODEL=

# --- billing (Phase 7) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- email (verification / reset) ---
SMTP_URL=
EMAIL_FROM=

# --- marketplace direct publishing (kept off by default) ---
MARKETPLACE_LIVE=         # "1" to enable live marketplace API push (Phase 8)
